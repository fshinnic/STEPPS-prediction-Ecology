# reduces information by taxa (declared (1,17), found (12,1, 127)[...])
# w <- matrix(1, nrow = 1, ncol = 1)###### getting non-posistve definite matrix , having issues with it sampeling across space
w <- matrix(1, nrow = 1, ncol = 1)
