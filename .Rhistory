library(tidyverse)
SNPs <- read.table("H938_chr15.geno", header = TRUE)
str(SNPs)
glimpse(SNPs)
# Pipe in the dataset
SNPs %>%
# Use mutate to add up the genotypes' number of observations & save this
# into the same object 'SNPs'.
mutate(nObs = nA1A1 + nA1A2 + nA2A2) -> SNPs
# Confirm the existence of the nObs column
str(SNPs)
glimpse(SNPs)
# Pipe in your dataset
SNPs %>%
# Use summarize to calculate the mean, min, and max of the total number of
# observations.
summarize(mean = mean(nObs),
min = min(nObs),
max = max(nObs))
# Pipe in your dataset
SNPs %>%
# Using mutate, create new columns for each of the genotypes
mutate(p11 = nA1A1/nObs,
p12 = nA1A2/nObs,
p22 = nA2A2/nObs,
# Compute allele frequencies from genotype frequencies, also with
# the mutate function
p1 = p11 + 0.5 * p12,
p2 = p22 + 0.5 * p12) -> SNPs
range(SNPs$p1 + SNPs$p2)
# Pipe in your dataset
SNPs %>%
# Select one of the allele frequency columns, and all 3 of the genotype
# proportion data
select(p1, p11, p12, p22) %>%
# Now pivot the data from wide to long format, using the allele freq. column
# as your "ID" column
pivot_longer(cols = !p1, names_to = "genotype", values_to = "proportion") -> SNPs_long
SNPs_long %>%
# Plot the data and color by genotype and change point shape by genotype as well
ggplot(aes(x = p1, y = proportion, color = genotype)) +
# Make the scatter plot
geom_point()
# Load palmerpenguins
library(palmerpenguins)
# Pipe in the dataset
penguins %>%
# Set x and y values, color by species
ggplot(aes(x = bill_depth_mm, y = bill_length_mm, color = species)) +
# Make it a scatterplot
geom_point() +
# Add the first line using the formula 2 * bill_length_mm to plot it
stat_function(fun = function(bill_length_mm) 2*bill_length_mm, geom = "line", color = "red", size = 2) +
# The next line uses the same formula as above, but with a y-int. of 10
stat_function(fun = function(bill_length_mm) 10 + 2*bill_length_mm, geom = "line", color = "green", size = 2)
# Add one more line here that makes a blue line with a y-int. of 20.
# Don't forget to add a '+' to line 262
SNPs_long %>%
ggplot(aes(x = p1, y = proportion, color = genotype)) +
geom_point() +
stat_function(fun = function(p1) p1^2, geom="line", colour="red",size=2.5) +
stat_function(fun = function(p1) 2*p1*(1-p1), geom="line", colour="green",size=2.5) +
stat_function(fun=function(p1) (1-p1)^2, geom="line", colour="blue",size=2.5)
# Pipe in the original dataset, SNPs
SNPs %>%
# Calculate X2 statistic
mutate(X2 = (nA1A1 - nObs * p1^2)^2 /(nObs * p1^2) +
(nA1A2 - nObs * 2 * p1 * p2)^2 / (nObs * 2 * p1 * p2) +
(nA2A2 - nObs * p2^2)^2 / (nObs * p2^2),
# Calculate p-value
pvalue = 1 - pchisq(X2, 1)) -> SNPs_stats
# Pipe in SNPs_stats
SNPs_stats %>%
# View the top 6 rows
head()
SNPs_stats %>%
mutate(is_significant = ifelse(pvalue < 0.05, 1, 0)) %>%
summarize(num_significant = sum(is_significant),
prop_significant = num_significant / nrow(SNPs_stats))
# The proportion of significant p-values in the data is >70%,
# so much higher than the expected 5% under the HWE null hypoth.
# Pipe in the original dataframe, SNPs
SNPs %>%
# Calculate expected proportion
mutate(Expected = 2 * p1 * p2,
# Rename p12 to observed
Observed = p12) %>%
# Set aesthetics
ggplot(aes(x = Expected, y = Observed)) +
# Make scatterplot
geom_point() +
# Add trendline
geom_abline(aes(intercept = 0, slope = 1), color = "red", size = 2)
