## Install the packages below BEFORE you run this chunk. ##
# our old friend tidyverse
library(tidyverse)
# For plotting multiple logistic regressions
#install.packages("ggiraphExtra")
library(ggiraphExtra)
# allows cross-validation cv.glm()
library(boot)
# Read in the data
wells <- read_csv("wells.csv")
# Check the structure
glimpse(wells)
# Pipe in the dataset
wells %>%
# Set aesthetics. Adjust fill color by whether the household switched or not.
# The function factor() makes sure R recognizes switch as a categorical
# variable for plotting (switch or not), rather than a continuous one (0-1).
ggplot(aes(x = dist100, fill = factor(switch))) +
# Make interleaved histogram with 100 bins
geom_histogram(position = "dodge", bins = 100)
# Pipe in the dataset
wells %>%
# Group by the switch variable (0, no, or 1, switch)
group_by(switch) %>%
# Calculate mean and standard deviation for each group (switch or not)
summarize(mean = mean(dist100),
sd = sd(dist100))
# Fit the model using glm()
glm(switch ~ dist100,
# Set the model type to binomial(link = "logit") for logistic regression.
family = binomial(link = "logit"), data=wells) -> DistMod
# Look at the model summary
summary(DistMod)
wells %>%
# Set distance to be explanatory and switch to be response
ggplot(aes(x = dist100, y = switch)) +
# Jitter points by height but not width. Also make points slightly transparent
geom_jitter(height = 0.05, width = 0, alpha = 0.2) +
# Add fitted model. We specify the type of model with the method.args argument
geom_smooth(method = "glm", method.args = list(family = "binomial"))
wells %>%
# Set aesthetics and color by switch (0 or 1)
ggplot(aes(x = arsenic, fill = factor(switch))) +
# Make interleaved histogram
geom_histogram(position = "dodge")
DistArsenicMod <- glm(switch ~ dist100 + arsenic, family = binomial(link = "logit"), data=wells)
summary(DistArsenicMod)
wells %>%
# Set aesthetics
ggplot(aes(x=dist100, y=arsenic)) +
# Add scatterplot
geom_point()
ggPredict(DistArsenicMod, se = TRUE)
cv_DistMod <- cv.glm(wells, DistMod, K = 3)
cv_DistMod$delta
cv_DistArsenicMod <- cv.glm(wells, DistArsenicMod, K = 3)
cv_DistArsenicMod$delta
# List of required packages
packages <- c("tidyverse", "gridExtra", "lme4", "ggResidpanel", "khroma")
# Install any packages that are not already installed
installed <- rownames(installed.packages())
for (pkg in packages) {
if (!(pkg %in% installed)) {
install.packages(pkg, dependencies = TRUE)
}
}
# Load the packages
library(tidyverse)    # Our old friend tidyverse
library(gridExtra)    # Making plots side by side
library(lme4)         # Fitting linear mixed-effect (lme) models
library(ggResidpanel) # Residual diagnostics
library(khroma)       # Color palette for color-blind people
# Read in the data
rikz_data <- read_tsv("rikz_data.txt") # read_tsv imports a tab-separated values file
# Some house cleaning
rikz_data <- mutate(rikz_data,
# Making sure that R knows beach is a factor
Beach = as.factor(Beach),
# Log-transforming richness and addin a constant of 1
# to make things simpler (see explanation below)
logRichness = log(Richness + 1),
# Standardize and center predictors for later (question 5)
scaledNAP = as.numeric(scale(NAP)),
scaledExposure = as.numeric(scale(Exposure)))
# Check the structure
glimpse(rikz_data)
# Fit the model
mod1 <- lm(logRichness ~ NAP, data = rikz_data)
summary(mod1)
# Residual panel
resid_panel(mod1)
# Calculate residuals from the linear model 'mod1'
residuals_mod1 <- residuals(mod1)
# Plot residuals against Beach (categorical predictor)
ggplot(rikz_data, aes(x = Beach, y = residuals_mod1)) +
# Boxplot of residuals by beach
geom_boxplot(fill = "#beaed4", color = "black", width = 0.5) +
labs(x = "Beach", y = "Residuals") +
theme_bw() +
# Rotate x labels for readability
theme(axis.text.x = element_text(angle = 45, hjust = 1))
# Fit the model
mod2 <- lm(logRichness ~ NAP + Beach, data = rikz_data)
summary(mod2)
# Plot residuals against Beach for mod1
plot1 <- ggplot(rikz_data, aes(x = Beach, y = residuals_mod1)) +
geom_boxplot(fill = "#beaed4", color = "black", width = 0.5) +
labs(x = "Beach", y = "Residuals") +
ggtitle("Mod1") +
theme_bw() +
theme(axis.text.x = element_text(angle = 45, hjust = 1))
# Calculate residuals from the linear model 'mod2'
residuals_mod2 <- residuals(mod2)
# Plot residuals against Beach for mod2
plot2 <- ggplot(rikz_data, aes(x = Beach, y = residuals_mod2)) +
geom_boxplot(fill = "#beaed4", color = "black", width = 0.5) +
labs(x = "Beach", y = "Residuals") +
ggtitle("Mod2") +
theme_bw() +
theme(axis.text.x = element_text(angle = 45, hjust = 1))
# Display both plots side-by-side in 2 columns
grid.arrange(plot1, plot2, ncol = 2)
# Fit the random-intercepts model
mod3 <- lmer(logRichness ~ NAP + (1|Beach), data = rikz_data)
# The (1|Beach) is the random effect term, where the 1 denotes this is a
# random-intercept model and the term on the right of the | is a nominal
# variable (or factor) to be used as the random effect.
summary(mod3)
confint.merMod(mod3) # 95% CI for mixed models
# Add a new column 'fit_mem.intercept' to the 'rikz_data' dataframe
rikz_data <- rikz_data %>%
mutate(
# Predict values using the model 'mod3' and assign them to a new column
fit_mem.intercept = predict(mod3)
)
# Create a ggplot to visualize the model
ggplot(rikz_data, aes(x = NAP, y = logRichness, colour = Beach)) +
# Add a line representing the **fixed effects** only (i.e., global intercept
# and slope for NAP).This is drawn using `geom_abline`, which uses the
# overall model intercept and slope.
# `fixef(mod3)` extracts fixed effects from the model
geom_abline(aes(intercept = `(Intercept)`, slope = NAP),
size = 2, # Line size
as.data.frame(t(fixef(mod3)))) +
# Add lines for each beach using predicted values that account for random
# intercepts. This shows how each beach's line differs vertically
# (in intercept) from the fixed effect line.
geom_line(aes(y = fit_mem.intercept), size = 1) +
# Add actual data points for each observation
geom_point(size = 3) +
# Use a classic theme for a cleaner look
theme_classic() +
# Use a color palette that distinguishes between beaches
khroma::scale_color_muted()
# Fit the random-slope and intercept model
mod4 <- lmer(logRichness ~ NAP + (1 + NAP|Beach), data = rikz_data)
# The (1 + NAP|Beach) is the random effect term, where the 1 still denotes
# a different baseline for each beach by having NAP on the left side of | you
# allow each beach to have its own NAP effect (slope).
summary(mod4)
# Let's plot the linear model for each beach, with a varying intercept only:
rikz_data$fit_IntSlope <- predict(mod4)
plot_mod4 <- ggplot(rikz_data, aes(x = NAP, y = logRichness, colour = Beach)) +
# Add fixed effect regression line (i.e. NAP)
geom_abline(aes(intercept = `(Intercept)`, slope = NAP),
size = 2,
as.data.frame(t(fixef(mod4)))) +
# Add fitted values (i.e. regression) for each beach
geom_line(aes(y = fit_IntSlope), size = 1) +
geom_point(size = 3) +
theme_classic() +
khroma::scale_color_muted()
plot_mod4
anova(mod3, mod4)
0.1185/(0.1185 + 0.1608)
mod5 <- lmer(logRichness ~ NAP + Exposure + (1 | Beach), data = rikz_data)
summary(mod5)
confint.merMod(mod5)
mod6 <- lmer(logRichness ~ scaledNAP + scaledExposure + (1 | Beach), data = rikz_data)
summary(mod6)
