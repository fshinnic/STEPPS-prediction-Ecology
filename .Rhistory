p_seperate <- ggplot() +
# Normal points + error bars
geom_point(
data = (df_normal %>% filter(Group == "Neonates")),
aes(x = Unit, y = Mean, color = Time),
position = position_dodge(width = 0.4),
size = 3
) +
geom_errorbar(
data = df_normal %>% filter(Group == "Neonates"),
aes(x = Unit, ymin = Lower, ymax = Upper, color = Time),
position = position_dodge(width = 0.4),
width = 0.2
) +
geom_text(
data = df_outliers %>% filter(Group == "Neonates"),
aes(x = Unit, y = Mean, color = Time, label = "*"),
position = position_dodge(width = 0.4),
size = 6,
fontface = "bold",
show.legend = FALSE
) +
facet_wrap(~Group, ncol = 3) +
labs(
x = "Unit",
y = "Mean (CFBf - CFBw)",
color = "ICU Day Group"
) +
scale_color_manual(
values = c(
