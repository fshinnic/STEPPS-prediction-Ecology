w = w,
P = P,
# psi,
lag = lag, # not used
N_p = N_p # not used
),
chains = 4,
parallel_chains = 1,
iter_warmup = 1000,
iter_sampling = 10,
output_dir = "/Users/finleyjean/Documents/STEPPS-prediction-Ecology/data/simple_stan_outputs"
)
fit$draws()
fit$draws(format = "df")
(fit$summary())$variable
fit$diagnostic_summary()
sum_df <- fit$summary()
head(sum_df)
# Check the column names
colnames(sum_df)
View(sum_df)
w
