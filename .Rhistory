y = y,
rho = rho,
eta = eta,
gamma = gamma,
phi = phi,
idx_cores = idx_cores,
d = d,
d_knots = d_knots,
d_inter = d_inter,
w = w,
P = P,
# psi,
lag = lag, # not used
N_p = N_p # not used
),
chains = 1,
parallel_chains = 1,
iter_warmup = 1000,
iter_sampling = 10
)
# Turn off draws
